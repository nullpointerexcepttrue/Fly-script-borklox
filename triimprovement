local presetBtns = {}

local function setWalkPreset(idx)
	currentWalkPreset = idx
	runSpeed = WALK_PRESETS[idx].speed
	-- Update button visuals
	for i, btn in ipairs(presetBtns) do
		if i == idx then
			tw(btn, { BackgroundColor3 = C.Gold, TextColor3 = C.Void })
		else
			tw(btn, { BackgroundColor3 = C.Charcoal, TextColor3 = C.Champagne })
		end
	end
	-- Apply immediately if walk is already ON
	if walkEnabled then
		updateCharacterReferences()
		if humanoid then humanoid.WalkSpeed = runSpeed end
	end
end

for i, preset in ipairs(WALK_PRESETS) do
	local btn = Instance.new("TextButton")
	btn.Size             = UDim2.new(0, 86, 1, 0)
	btn.BackgroundColor3 = i == currentWalkPreset and C.Gold or C.Charcoal
	btn.Text             = preset.label .. "  (" .. preset.speed .. ")"
	btn.TextColor3       = i == currentWalkPreset and C.Void or C.Champagne
	btn.TextSize         = 10
	btn.Font             = Enum.Font.GothamSemibold
	btn.BorderSizePixel  = 0
	btn.LayoutOrder      = i
	btn.Parent           = presetRow
	corner(btn, 4)
	stroke(btn, C.Wire)

	presetBtns[i] = btn

	btn.MouseButton1Click:Connect(function()
		setWalkPreset(i)
	end)
	btn.MouseEnter:Connect(function()
		if currentWalkPreset ~= i then
			tw(btn, { BackgroundColor3 = C.GoldDim, TextColor3 = C.GoldBright })
		end
	end)
	btn.MouseLeave:Connect(function()
		if currentWalkPreset ~= i then
			tw(btn, { BackgroundColor3 = C.Charcoal, TextColor3 = C.Champagne })
		end
	end)
end

