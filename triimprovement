-- ══════════════════════════════════════════════════════════════════════════════
local foundTargetPlayer = nil  -- stores the found player object

local function setSearchResult(msg, color, showTpBtn)
	searchResultLbl.Text      = msg
	searchResultLbl.TextColor3= color or C.Champagne
	tpToPlayerBtn.Visible     = showTpBtn or false
	if showTpBtn then
		-- Expand card height to show the teleport button
		searchCard.Size = UDim2.new(1, 0, 0, 152)
	else
		searchCard.Size = UDim2.new(1, 0, 0, 148)
	end
end

searchBtn.MouseButton1Click:Connect(function()
	local query = searchInput.Text:match("^%s*(.-)%s*$"):lower()
	if query == "" then
		setSearchResult("⚠ Enter a username to search.", C.Gold, false)
		foundTargetPlayer = nil
		return
	end

	foundTargetPlayer = nil
	setSearchResult("Searching…", C.Champagne, false)

	local allPlayers = Players:GetPlayers()
	local found      = nil

	-- First: exact match (case-insensitive)
	for _, p in ipairs(allPlayers) do
		if p.Name:lower() == query or p.DisplayName:lower() == query then
			found = p
			break
		end
	end

	-- Fallback: partial match
	if not found then
		for _, p in ipairs(allPlayers) do
			if p.Name:lower():find(query, 1, true)
			or p.DisplayName:lower():find(query, 1, true) then
				found = p
				break
			end
		end
	end

	if found then
		foundTargetPlayer = found
		local displayStr = found.DisplayName
		if found.DisplayName ~= found.Name then
			displayStr = found.DisplayName .. " (@" .. found.Name .. ")"
		end
		setSearchResult("✔ FOUND: " .. displayStr, C.GreenBright, true)
		tpToPlayerBtn.Text = "⚡ TELEPORT TO  " .. found.DisplayName:upper()
	else
		setSearchResult("✗ Player not found: " .. query, C.RedBright, false)
	end
end)

-- Teleport to found player
tpToPlayerBtn.MouseButton1Click:Connect(function()
	if not foundTargetPlayer then return end

	updateCharacterReferences()
	if not rootPart then return end

	local targetChar = foundTargetPlayer.Character
	if not targetChar then
		setSearchResult("✗ Player has no character loaded.", C.RedBright, false)
		return
	end

	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
	if not targetRoot then
		setSearchResult("✗ Cannot locate player position.", C.RedBright, false)
		return
	end

	-- Teleport slightly beside the target so we don't overlap
	rootPart.CFrame = targetRoot.CFrame * CFrame.new(3, 0, 0)
	setSearchResult("✔ Teleported to " .. foundTargetPlayer.DisplayName .. "!", C.GreenBright, true)
end)

