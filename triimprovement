--  DUPLICATE AVATAR LOGIC
-- ══════════════════════════════════════════════════════════════════════════════
local function setDupStatus(msg, col)
	dupStatus.Text       = msg
	dupStatus.TextColor3 = col or C.Champagne
end

local function applyAppearanceFromDescription(desc)
	local bodyColors = desc.BodyColors
	if bodyColors then
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum then
			local bc = hum:FindFirstChildOfClass("BodyColors")
			if not bc then bc = Instance.new("BodyColors"); bc.Parent = hum end
			bc.HeadColor3      = bodyColors.HeadColor
			bc.TorsoColor3     = bodyColors.TorsoColor
			bc.LeftArmColor3   = bodyColors.LeftArmColor
			bc.RightArmColor3  = bodyColors.RightArmColor
			bc.LeftLegColor3   = bodyColors.LeftLegColor
			bc.RightLegColor3  = bodyColors.RightLegColor
		end
	end

	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants")
		   or item:IsA("ShirtGraphic") or item:IsA("SpecialMesh") then
			item:Destroy()
		end
	end
	local head = character:FindFirstChild("Head")
	if head then
		for _, d in ipairs(head:GetChildren()) do
			if d:IsA("Decal") and d.Name == "face" then d:Destroy() end
		end
	end

	local function tryAddAsset(assetType, assetId)
		if assetId == 0 then return end
		local ok, err = pcall(function()
			if assetType == "Shirt" then
				local s = Instance.new("Shirt")
				s.ShirtTemplate = "rbxassetid://"..assetId
				s.Parent = character
			elseif assetType == "Pants" then
				local p = Instance.new("Pants")
				p.PantsTemplate = "rbxassetid://"..assetId
				p.Parent = character
			elseif assetType == "Face" then
				if head then
					local d = Instance.new("Decal")
					d.Name    = "face"
					d.Texture = "rbxassetid://"..assetId
					d.Face    = Enum.NormalId.Front
					d.Parent  = head
				end
			elseif assetType == "Accessory" then
				local accessory = game:GetService("InsertService"):LoadAsset(assetId)
				if accessory then
					local acc = accessory:FindFirstChildOfClass("Accessory")
					if acc then
						acc.Parent = character
						accessory:Destroy()
					else
						accessory:Destroy()
					end
				end
			end
		end)
		if not ok then
			warn("DupAvatar: failed to load "..assetType.." "..assetId..": "..tostring(err))
		end
	end

	tryAddAsset("Shirt",  desc.ShirtAssetId  or 0)
	tryAddAsset("Pants",  desc.PantsAssetId  or 0)
	tryAddAsset("Face",   desc.FaceAssetId   or 0)

	for _, id in ipairs(desc.AccessoryAssetIds or {}) do
		tryAddAsset("Accessory", id)
	end
end

dupSearchBtn.MouseButton1Click:Connect(function()
	local username = dupInput.Text:match("^%s*(.-)%s*$")
	if username == "" then
		setDupStatus("⚠ Please enter a username.", C.Gold)
		return
	end

	setDupStatus("⏳ Processing…", C.Champagne)
	tw(dupSearchBtn, { BackgroundColor3 = C.Charcoal, TextColor3 = C.Ash })

	task.spawn(function()
		local userId
		local ok1, err1 = pcall(function()
			userId = Players:GetUserIdFromNameAsync(username)
		end)

		if not ok1 or not userId then
			setDupStatus("✗ User not found: "..username, Color3.fromRGB(200, 80, 80))
			tw(dupSearchBtn, { BackgroundColor3 = C.GoldDim, TextColor3 = C.GoldBright })
			return
		end

		local desc
		local ok2, err2 = pcall(function()
			desc = Players:GetHumanoidDescriptionFromUserId(userId)
		end)

		if not ok2 or not desc then
			setDupStatus("✗ Could not fetch appearance.", Color3.fromRGB(200, 80, 80))
			tw(dupSearchBtn, { BackgroundColor3 = C.GoldDim, TextColor3 = C.GoldBright })
			return
		end

		updateCharacterReferences()
		local ok3, err3 = pcall(function()
			if humanoid then humanoid:ApplyDescription(desc) end
		end)

		if ok3 then
			setDupStatus("✔ Copied "..username.."'s avatar!", Color3.fromRGB(100, 200, 120))
		else
			local ok4, err4 = pcall(applyAppearanceFromDescription, desc)
			if ok4 then
				setDupStatus("✔ Copied "..username.."'s avatar!", Color3.fromRGB(100, 200, 120))
			else
				setDupStatus("✗ Apply failed: "..tostring(err3), Color3.fromRGB(200, 80, 80))
			end
		end

		tw(dupSearchBtn, { BackgroundColor3 = C.GoldDim, TextColor3 = C.GoldBright })
	end)
end)
