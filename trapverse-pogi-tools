-- ════════════════════════════════════════════════════════════════
--  FIXED applyAnimPack
--  Problem was: Disabled = true/false on the Animate LocalScript
--  does NOT reliably force a reload from a LocalScript executor.
--  FIX: Clone the Animate script, destroy the original, re-parent
--       the clone — same trick Roblox uses internally.
-- ════════════════════════════════════════════════════════════════
local function applyAnimPack(packKey, btn)
	updateCharacterReferences()

	if not humanoid or not character then
		animStatus.Text = "✗ Character not ready."
		animStatus.TextColor3 = C.RedBright
		return
	end

	-- Support both R6 and R15 (same slot names work for R6 too)
	local ids = ANIM_IDS[packKey]
	if not ids then return end

	local animateScript = character:FindFirstChild("Animate")
	if not animateScript then
		animStatus.Text = "✗ Animate script not found."
		animStatus.TextColor3 = C.RedBright
		return
	end

	-- Clone BEFORE modifying so originals are intact if it fails
	local animClone = animateScript:Clone()

	local function applyToSlot(slotName, animId)
		local slot = animClone:FindFirstChild(slotName)
		if not slot then return end
		-- Walk and Idle slots have multiple Animation children with weights;
		-- update ALL of them so the random picker also gets the new ID.
		for _, obj in ipairs(slot:GetDescendants()) do
			if obj:IsA("Animation") then
				obj.AnimationId = "rbxassetid://" .. tostring(animId)
			end
		end
	end

	local success, err = pcall(function()
		applyToSlot("walk",     ids.Walk)
		applyToSlot("run",      ids.Run)
		applyToSlot("jump",     ids.Jump)
		applyToSlot("fall",     ids.Fall)
		applyToSlot("swim",     ids.Swim)
		applyToSlot("swimidle", ids.Swim)
		applyToSlot("climb",    ids.Climb)
		applyToSlot("idle",     ids.Idle)
		-- Some games also have toolnone / toolslash etc, leave untouched
	end)

	if not success then
		animStatus.Text = "✗ Error: " .. tostring(err)
		animStatus.TextColor3 = C.RedBright
		animClone:Destroy()
		return
	end

	-- Swap: destroy original, parent clone (this forces the Animate
	-- LocalScript to restart and pick up new animation IDs immediately)
	animateScript:Destroy()
	animClone.Disabled = false
	animClone.Parent   = character

	-- Nudge the humanoid so it enters a new state and plays the anim
	task.wait(0.05)
	if humanoid and humanoid.Parent then
		humanoid:ChangeState(Enum.HumanoidStateType.Running)
	end

	animStatus.Text       = "✔ " .. packKey .. " applied!"
	animStatus.TextColor3 = C.GreenBright

	-- Update button highlights
	if activeAnimBtn and activeAnimBtn ~= btn then
		tw(activeAnimBtn, { BackgroundColor3 = C.Charcoal, TextColor3 = C.Champagne })
	end
	activeAnimBtn = btn
	tw(btn, { BackgroundColor3 = C.Gold, TextColor3 = C.Void })
end

